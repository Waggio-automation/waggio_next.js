{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:tunnel": "concurrently -n next,ngrok -c blue,magenta \"next dev\" \"ngrok http 3000\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types src/tests/cra-settings-validators.test.ts src/tests/cron-security.test.ts src/tests/date-only.test.ts src/tests/date-validation.test.ts src/tests/sin-security.test.ts src/tests/status-mapping.test.ts src/tests/trolley-timeout.test.ts src/tests/workflow-removal.test.ts",
    "test:integration:cra": "dotenv -e .env.local -- node --experimental-strip-types scripts/run-cra-integration-tests.ts",
    "sin:backfill": "node --experimental-strip-types scripts/backfill-employee-sins.ts",
    "cra:artifacts:reconcile": "node --experimental-strip-types scripts/reconcile-cra-artifacts.ts",
    "migrate:local": "dotenv -e .env.local -- prisma migrate dev",
    "studio:local": "dotenv -e .env.local -- prisma studio"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@sparticuz/chromium": "^147.0.0",
    "@vercel/blob": "^2.4.0",
    "next": "^15.5.4",
    "nodemailer": "^9.0.3",
    "puppeteer": "^24.38.0",
    "puppeteer-core": "^24.43.1",
    "react": "^18.3.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.0.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "pdfjs-dist": "^6.1.200",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
