# Waggio 환경변수 템플릿 — 실제 값은 절대 커밋하지 말 것 (.gitignore가 .env*를 무시함)
# 전체 인벤토리/설명: docs/operations/env-inventory.md

# ── Database (필수) ────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/payroll_db?schema=public"
# pooler(Neon 등) 사용 시 direct connection URL
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ── App URL (필수) ─────────────────────────────────────────────
# 비밀번호 재설정 링크, Stripe 리다이렉트 등에 사용
APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── 인증/보안 (필수) ────────────────────────────────────────────
# 회사 관리자 세션 서명용 랜덤 문자열 (예: openssl rand -base64 32)
COMPANY_ADMIN_SESSION_SECRET=
# SIN 암호화 키 — 64자 hex 필수 (예: openssl rand -hex 32)
# 주의: 교체 시 기존 암호화 데이터 복호화 불가 — 재암호화 마이그레이션 필요
ENCRYPTION_KEY=
# Vercel cron 인증용 (프로덕션 필수, 예: openssl rand -hex 32)
CRON_SECRET=

# ── Stripe (필수) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# 웹훅 엔드포인트별 시크릿 (프로덕션 필수)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Trolley (필수) ─────────────────────────────────────────────
TROLLEY_ACCESS_KEY=
TROLLEY_SECRET_KEY=
# 기본값 내장 — override 필요 시에만
# TROLLEY_BASE_URL=

# ── Google Maps (필수, 클라이언트 노출 — referrer 제한 설정할 것) ──
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── PDF 서버 (필수) ────────────────────────────────────────────
PDF_SERVER_URL=
PDF_SERVER_SECRET=

# ── SMTP 이메일 (이메일 발송 시 필수) ────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=no-reply@yourdomain.com
# SMTP_FROM_NAME=Waggio Payroll

# ── 스크립트/테스트 전용 (배포 환경 불필요) ────────────────────────
# CRA_INTEGRATION_DATABASE_URL=
# CRA_INTEGRATION_ALLOW_REMOTE=1
# CRA_GENERATED_DIR=
# T4_CRASH_TAX_YEAR=
# T4_CRASH_COMPANY_ID=
