// ─────────────────────────────────────────────
// Employee 관련 테이블 (리팩토링)
// ─────────────────────────────────────────────

model Employee {
  id             BigInt         @id @default(autoincrement())
  companyId      BigInt?
  firstName      String
  lastName       String
  email          String
  employeeNumber String?
  sin            String
  birthDate      DateTime
  hireDate       DateTime
  employmentType EmploymentType

  addrLine1    String
  addrLine2    String?
  addrCity     String
  addrProvince String   @default("ON")
  addrPostal   String
  addrCountry  String   @default("CA")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  payConfigs     EmployeePayConfig[]
  taxConfigs     EmployeeTaxConfig[]
  benefitConfigs EmployeeBenefitsConfig[]
  bankAccounts   EmployeeBankAccount[]
  payoutConfig   EmployeePayoutConfig?
  payHistory     PayHistory[]
  t4Slips        T4Slip[]

  @@index([companyId])
  @@index([email, hireDate])
}

model EmployeePayConfig {
  id          BigInt   @id @default(autoincrement())
  employeeId  BigInt
  department  String?
  jobTitle    String?
  payGroup    PayGroup @default(BI_WEEKLY)
  payType     PayType
  hourlyRate  Decimal?
  salary      Decimal?
  vacationPay Decimal  @default(4)
  bonus       Decimal  @default(0)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
}

model EmployeeTaxConfig {
  id            BigInt  @id @default(autoincrement())
  employeeId    BigInt
  federalTD1    Decimal @default(16452)
  provincialTD1 Decimal @default(12989)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
}

model EmployeeBenefitsConfig {
  id                        BigInt                 @id @default(autoincrement())
  employeeId                BigInt
  dentalBenefitsCoverage    DentalBenefitsCoverage @default(NONE)
  rppDpspRegistrationNumber String?
  pensionAdjustmentOverride Decimal?
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
}

model EmployeeBankAccount {
  id                  BigInt        @id @default(autoincrement())
  employeeId          BigInt
  paymentMethod       PaymentMethod @default(CHEQUE)
  institutionNumber   String?
  transitBranchNumber String?
  accountNumber       String?
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
}

model EmployeePayoutConfig {
  id                          BigInt            @id @default(autoincrement())
  employeeId                  BigInt            @unique
  trolleyRecipientId          String?
  trolleyReferenceId          String?           @unique
  trolleyRecipientAccountId   String?           @unique
  trolleyRecipientAccountType String?
  payoutEnabled               Boolean           @default(false)
  payoutSetupStatus           PayoutSetupStatus @default(REQUIRED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}