generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Employee {
  id                          BigInt                 @id @default(autoincrement())
  firstName                   String
  lastName                    String
  email                       String
  employeeNumber              String?
  department                  String?
  jobTitle                    String?
  institutionNumber           String?
  transitBranchNumber         String?
  accountNumber               String?
  sin                         String
  dentalBenefitsCoverage      DentalBenefitsCoverage @default(NONE)
  paymentMethod               PaymentMethod          @default(CHEQUE)
  addrLine1                   String
  addrLine2                   String?
  addrCity                    String
  addrProvince                String                 @default("ON")
  addrPostal                  String
  addrCountry                 String                 @default("CA")
  birthDate                   DateTime
  employmentType              EmploymentType
  hireDate                    DateTime
  payGroup                    PayGroup               @default(BI_WEEKLY)
  payType                     PayType
  hourlyRate                  Decimal?
  salary                      Decimal?
  rppDpspRegistrationNumber   String?
  pensionAdjustmentOverride   Decimal?
  vacationPay                 Decimal                @default(4)
  bonus                       Decimal                @default(0)
  federalTD1                  Decimal                @default(16452)
  provincialTD1               Decimal                @default(12989)
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  trolleyRecipientId          String?
  trolleyReferenceId          String?                @unique
  payoutEnabled               Boolean                @default(false)
  payoutSetupStatus           PayoutSetupStatus      @default(REQUIRED)
  companyId                   BigInt?
  trolleyRecipientAccountId   String?                @unique
  trolleyRecipientAccountType String?
  company                     Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  payHistory                  PayHistory[]
  t4Slips                     T4Slip[]

  @@index([companyId])
  @@index([companyId, trolleyReferenceId])
  @@index([email, hireDate])
}

model PayHistory {
  id                    BigInt                 @id @default(autoincrement())
  employeeId            BigInt
  payDate               DateTime
  grossPay              Decimal
  ded_cpp               Decimal                @default(0)
  ded_ei                Decimal                @default(0)
  ded_income_tax        Decimal                @default(0)
  ded_eht               Decimal                @default(0)
  ded_wsib              Decimal                @default(0)
  netPay                Decimal
  paidAt                DateTime?
  paymentProvider       String?
  paymentRef            String?
  failureReason         String?
  attemptCount          Int                    @default(0)
  lastAttemptAt         DateTime?
  review_valid          Boolean                @default(true)
  review_errors         String[]               @default([])
  review_warnings       String[]               @default([])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  payrollRunId          BigInt?
  hoursWorked           Decimal?
  deliveryStatus        String?
  emailProvider         String?
  emailSentAt           DateTime?
  status                PayHistoryStatus       @default(PENDING)
  pdfUrl                String?
  periodStart           DateTime?
  periodEnd             DateTime?
  sequenceNumber        String?
  employee              Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRun            PayrollRun?            @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  remittanceAllocations RemittancePayHistory[]

  @@index([employeeId, payDate])
  @@index([payrollRunId])
}

model PayrollRun {
  id            BigInt              @id @default(autoincrement())
  companyId     BigInt?
  company       Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  payDate       DateTime
  sendAt        DateTime?
  status        PayrollRunStatus    @default(SCHEDULED)
  failureType   PayrollFailureType?
  failureReason String?
  providerRef   String?
  billingMonthKey String?
  extraRunSequence Int?
  extraRunFeeCents Int?
  extraRunInvoiceItemId String?
  extraRunBilledAt DateTime?
  extraRunBillingError String?
  meta          Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  payHistory PayHistory[]

  @@index([companyId])
  @@index([payDate, status])
  @@index([sendAt])
  @@index([companyId, billingMonthKey])
}

model Company {
  id                  BigInt                  @id @default(autoincrement())
  name                String?
  adminEmail          String
  addrLine1           String?
  addrLine2           String?
  addrCity            String?
  addrProvince        String?
  addrPostal          String?
  trolleyTenantKey    String?                 @unique
  adminTokenHash      String?
  adminTokenCreatedAt DateTime?
  currentPlan         CompanyPlan?
  planSelectedAt      DateTime?
  stripeCustomerId    String?                 @unique
  stripeSubscriptionId String?                @unique
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  auditLogs           AuditLog[]
  payrollSettings     CompanyPayrollSettings?
  settings            CompanySettings?
  documents           Document[]
  employees           Employee[]
  payrollRuns         PayrollRun[]
  reminderEvents      ReminderEvent[]
  remittances         Remittance[]
  t4Slips             T4Slip[]
  t4Summaries         T4Summary[]
  users               CompanyUser[]
}

model CompanyUser {
  id           BigInt          @id @default(autoincrement())
  companyId    BigInt
  email        String          @unique
  passwordHash String
  passwordResetTokenHash String?
  passwordResetRequestedAt DateTime?
  firstName    String?
  lastName     String?
  role         CompanyUserRole @default(OWNER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model CompanySettings {
  id                    BigInt            @id @default(autoincrement())
  payoutEnabled         Boolean           @default(false)
  payoutSetupStatus     PayoutSetupStatus @default(REQUIRED)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  companyId             BigInt?           @unique
  defaultPayoutCurrency String            @default("CAD")
  defaultPayoutCountry  String            @default("CA")
  trolleyBatchPrefix    String?
  company               Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model CompanyPayrollSettings {
  id                           BigInt       @id @default(autoincrement())
  companyId                    BigInt       @unique
  legalName                    String?
  businessNumber               String?
  payrollProgramAccount        String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  provinceCode                 String?
  postalCode                   String?
  countryCode                  String?      @default("CAN")
  remitterType                 RemitterType @default(MONTHLY)
  contactName                  String?
  contactPhone                 String?
  contactPhoneExtension        String?
  contactEmail                 String?
  transmitterAccountNumber     String?
  transmitterRepId             String?
  submissionLanguageCode       String?      @default("E")
  preDueReminderDays           Int          @default(7)
  postDueReminderFrequencyDays Int          @default(7)
  firstRemittancePeriodStart   DateTime?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
  company                      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Remittance {
  id                   BigInt           @id @default(autoincrement())
  companyId            BigInt
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodStart          DateTime
  periodEnd            DateTime
  remitterTypeSnapshot RemitterType
  status               RemittanceStatus @default(DUE)
  dueDate              DateTime
  employeeCount        Int              @default(0)
  totalIncomeTax       Decimal          @default(0)
  totalCppEmployee     Decimal          @default(0)
  totalCppEmployer     Decimal          @default(0)
  totalEiEmployee      Decimal          @default(0)
  totalEiEmployer      Decimal          @default(0)
  totalPayable         Decimal          @default(0)
  paidAt               DateTime?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  payments    RemittancePayment[]
  allocations RemittancePayHistory[]
  documents   Document[]
  reminders   ReminderEvent[]

  @@unique([companyId, periodStart, periodEnd])
  @@index([companyId, dueDate, status])
}

model RemittancePayHistory {
  remittanceId BigInt
  payHistoryId BigInt     @unique
  createdAt    DateTime   @default(now())
  payHistory   PayHistory @relation(fields: [payHistoryId], references: [id], onDelete: Cascade)
  remittance   Remittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)

  @@id([remittanceId, payHistoryId])
  @@index([payHistoryId])
}

model RemittancePayment {
  id              BigInt                  @id @default(autoincrement())
  remittanceId    BigInt
  paymentDate     DateTime
  amountPaid      Decimal
  paymentMethod   String?
  referenceNumber String?
  status          RemittancePaymentStatus @default(RECORDED)
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  documents       Document[]
  remittance      Remittance              @relation(fields: [remittanceId], references: [id], onDelete: Cascade)

  @@index([remittanceId, paymentDate])
}

model T4Slip {
  id                       BigInt             @id @default(autoincrement())
  companyId                BigInt
  employeeId               BigInt
  taxYear                  Int
  status                   T4GenerationStatus @default(NOT_GENERATED)
  employmentIncome         Decimal            @default(0)
  incomeTaxDeducted        Decimal            @default(0)
  cppContributionsEmployee Decimal            @default(0)
  eiPremiumsEmployee       Decimal            @default(0)
  otherBoxPayload          Json?
  generatedAt              DateTime?
  finalizedAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  summaryId                BigInt?
  documents                Document[]
  company                  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee                 Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  summary                  T4Summary?         @relation(fields: [summaryId], references: [id], onDelete: SetNull)

  @@unique([companyId, employeeId, taxYear])
  @@index([companyId, taxYear, status])
}

model T4Summary {
  id                     BigInt             @id @default(autoincrement())
  companyId              BigInt
  taxYear                Int
  status                 T4GenerationStatus @default(NOT_GENERATED)
  employeeCount          Int                @default(0)
  totalEmploymentIncome  Decimal            @default(0)
  totalIncomeTaxDeducted Decimal            @default(0)
  totalCppEmployee       Decimal            @default(0)
  totalEiEmployee        Decimal            @default(0)
  generatedAt            DateTime?
  finalizedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  documents              Document[]
  slips                  T4Slip[]
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, taxYear])
}

model ReminderEvent {
  id            BigInt        @id @default(autoincrement())
  companyId     BigInt
  remittanceId  BigInt?
  reminderState ReminderState
  scheduledFor  DateTime
  sentAt        DateTime?
  channel       String        @default("dashboard")
  createdAt     DateTime      @default(now())
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  remittance    Remittance?   @relation(fields: [remittanceId], references: [id], onDelete: Cascade)

  @@index([companyId, scheduledFor])
  @@index([remittanceId, reminderState])
}

model Document {
  id                  BigInt             @id @default(autoincrement())
  companyId           BigInt
  documentType        DocumentType
  fileName            String
  storagePath         String
  mimeType            String             @default("application/json")
  linkedEntityType    LinkedEntityType
  linkedEntityId      BigInt
  taxYear             Int?
  uploadedBy          String?
  uploadedAt          DateTime           @default(now())
  remittanceId        BigInt?
  remittancePaymentId BigInt?
  t4SlipId            BigInt?
  t4SummaryId         BigInt?
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  remittance          Remittance?        @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  remittancePayment   RemittancePayment? @relation(fields: [remittancePaymentId], references: [id], onDelete: Cascade)
  t4Slip              T4Slip?            @relation(fields: [t4SlipId], references: [id], onDelete: Cascade)
  t4Summary           T4Summary?         @relation(fields: [t4SummaryId], references: [id], onDelete: Cascade)

  @@index([companyId, documentType, uploadedAt])
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  companyId    BigInt
  actorType    String
  actorId      String?
  action       String
  targetType   String
  targetId     String
  metadataJson Json?
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([targetType, targetId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

enum PayGroup {
  BI_WEEKLY
  MONTHLY
}

enum PayType {
  HOURLY
  SALARY
}

enum PaymentMethod {
  CHEQUE
  DIRECT_DEPOSIT
}

enum DentalBenefitsCoverage {
  NONE
  EMPLOYEE_ONLY
  EMPLOYEE_AND_SPOUSE
  EMPLOYEE_AND_CHILDREN
  EMPLOYEE_AND_FAMILY
}

enum PayHistoryStatus {
  PENDING     //안쓰임
  PROCESSING //안쓰임
  PROCESSED
  READY
  SENT
  SENDING
  EMAIL_SENT
  FAILED
}

enum PayoutSetupStatus {
  REQUIRED
  PENDING
  READY
  ISSUE
}

enum PayrollRunStatus {
  SCHEDULED
  FUNDING
  FUNDS_CONFIRMED
  PAYING
  PAID
  FAILED
  PROCESSED
}

enum PayrollFailureType {
  FUNDING
  EMPLOYEE
}

enum RemitterType {
  MONTHLY
  QUARTERLY
  ACCELERATED_THRESHOLD_1
  ACCELERATED_THRESHOLD_2
}

enum RemittanceStatus {
  DUE
  PAID
  PARTIALLY_PAID
  OVERDUE
}

enum RemittancePaymentStatus {
  RECORDED
  VOIDED
}

enum T4GenerationStatus {
  NOT_GENERATED
  GENERATED
  FINALIZED
}

enum ReminderState {
  UPCOMING
  DUE_TODAY
  OVERDUE
  PAID_NO_REMINDER
}

enum DocumentType {
  REMITTANCE_REPORT
  REMITTANCE_PAYMENT_PROOF
  T4_SLIP
  T4_SUMMARY
  OWNER_UPLOADED_RECEIPT
  OTHER
}

enum LinkedEntityType {
  REMITTANCE
  REMITTANCE_PAYMENT
  T4_SLIP
  T4_SUMMARY
  COMPANY
}

enum CompanyPlan {
  BASIC
  PRO
}

enum CompanyUserRole {
  OWNER
  ADMIN
}
